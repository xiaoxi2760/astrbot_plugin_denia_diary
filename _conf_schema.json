{
  "enabled": {
    "type": "bool",
    "default": true,
    "description": "总开关",
    "hint": "关闭后日记、小本本、状态、主动消息、早晚安全部停用（数据保留）"
  },
  "timezone": {
    "type": "string",
    "default": "Asia/Shanghai",
    "description": "时区",
    "hint": "IANA 时区名。云主机在 UTC 时必须显式设置，否则日期与提醒时段会错位"
  },
  "data_dir": {
    "type": "string",
    "default": "",
    "description": "数据目录",
    "hint": "留空＝用 AstrBot 的插件数据目录"
  },
  "panel": {
    "type": "object",
    "description": "面板外观",
    "hint": "只改观察面板怎么显示",
    "items": {
      "brand": {
        "type": "string",
        "default": "情绪日记",
        "description": "面板标题",
        "hint": "左上角大字；留空＝不显示"
      },
      "brand_sub": {
        "type": "string",
        "default": "观察面板",
        "description": "面板副标题",
        "hint": "标题下的小字；留空＝不显示"
      }
    }
  },
  "subsystems": {
    "type": "object",
    "description": "子系统开关",
    "hint": "调试期可以只关一块",
    "items": {
      "diary": {
        "type": "bool",
        "default": true,
        "description": "日记",
        "hint": "她能写日记、翻日记"
      },
      "notebook": {
        "type": "bool",
        "default": true,
        "description": "小本本",
        "hint": "记约定与事实"
      },
      "state": {
        "type": "bool",
        "default": true,
        "description": "状态",
        "hint": "情绪 / 作息 / 熟悉度"
      },
      "proactive": {
        "type": "bool",
        "default": true,
        "description": "主动消息",
        "hint": "她主动找你"
      },
      "greeting": {
        "type": "bool",
        "default": true,
        "description": "早晚安",
        "hint": "他说早安/晚安时记下来，她自然接话；关了就当普通聊天"
      },
      "social": {
        "type": "bool",
        "default": true,
        "description": "群社交",
        "hint": "登记的群里适度参与、登记 bot 短聊；关了就完全不观察群消息"
      }
    }
  },
  "scope": {
    "type": "object",
    "description": "启用范围",
    "hint": "她在哪里工作：记录 / 注入 / 写工具与主动对象都跟着这一档走",
    "items": {
      "mode": {
        "type": "string",
        "default": "private",
        "description": "档位",
        "hint": "owner=只主人私聊；private=任何私聊（默认）；all=私聊+群聊。非法值回落 private"
      }
    }
  },
  "diary": {
    "type": "object",
    "description": "日记参数",
    "items": {
      "edit_within_days": {
        "type": "int",
        "default": 7,
        "description": "可改天数",
        "hint": "1-60；更早的是历史，只读"
      },
      "panel_edit_unlimited": {
        "type": "bool",
        "default": false,
        "description": "面板不受可改天数限制",
        "hint": "关（默认）＝面板与聊天同一口径，只能改最近这些天；开＝只有 WebUI 面板能改任何一段，聊天侧仍然守 7 天"
      },
      "max_chars": {
        "type": "int",
        "default": 1200,
        "description": "单条上限（字）",
        "hint": "200-20000"
      },
      "nudge_after_hour": {
        "type": "int",
        "default": 22,
        "description": "深夜催促时刻",
        "hint": "0-23；到这个点还没写就换一句更重的提醒"
      },
      "soft_nudge_after_hour": {
        "type": "int",
        "default": 19,
        "description": "傍晚提醒时刻",
        "hint": "0-23；到点后只轻轻提一句"
      },
      "event_hint_cooldown_min": {
        "type": "int",
        "default": 30,
        "description": "事件提醒冷却（分钟）",
        "hint": "5-1440"
      },
      "fallback_hint_cooldown_min": {
        "type": "int",
        "default": 90,
        "description": "弱提醒冷却（分钟）",
        "hint": "15-1440"
      },
      "exchange_window_min": {
        "type": "int",
        "default": 30,
        "description": "“刚聊过”时间窗（分钟）",
        "hint": "5-1440；判断刚才有没有来回对话"
      },
      "card_render": {
        "type": "string",
        "default": "pretty",
        "description": "日记卡渲染方式（/看日记）",
        "hint": "pretty=精美卡片；plain=本地朴素图；off=只发文本。默认禁止上传日记，允许远端出图需另开开关"
      },
      "card_style": {
        "type": "string",
        "default": "paper",
        "description": "日记卡款式",
        "hint": "paper=纸感（默认）；ink=墨信；postcard=明信片；tape=手帐；dots=点阵本；seal=火漆信笺。非法值回落 paper"
      },
      "card_font": {
        "type": "string",
        "default": "",
        "description": "日记卡字体（自定义）",
        "hint": "留空＝用款式自带的字体。填字体名（如 Noto Serif SC）或字体文件直链（http…woff2 / ttf / otf）都行"
      },
      "card_engine": {
        "type": "string",
        "default": "auto",
        "description": "日记卡出图引擎（pretty 档）",
        "hint": "playwright=本机 Chrome/Edge 截图（约1秒，排版最贴模板）；remote=AstrBot 官方转图服务（约4-6秒，六款样式都能选）；pil=Pillow 直接画（完全离线，但只画纸感那一款）；auto=按前三者顺序挑第一个可用的（默认）。选中的引擎失败会自动往下退并记日志。非法值回落 auto"
      },
      "card_allow_remote": {
        "type": "bool",
        "default": false,
        "description": "允许把日记发到远端转图服务",
        "hint": "关（默认）＝日记只在本机出图（playwright → pil），任何引擎失败都不会上传到远端；开＝允许 remote 引擎上传整张日记卡到 AstrBot 官方转图服务。这一项优先于上面的引擎选择：选了 remote/auto 但这里是关的，就当 remote 不存在，改走本机引擎并在日志里说明"
      }
    }
  },
  "notebook": {
    "type": "object",
    "description": "小本本参数",
    "hint": "每人每类的条目上限；满了不报错，提示先删几条",
    "items": {
      "promise_limit": {
        "type": "int",
        "default": 20,
        "description": "约定上限（每人）",
        "hint": "1-200；按未完成计，完成即腾坑"
      },
      "fact_limit": {
        "type": "int",
        "default": 15,
        "description": "事实上限（每人）",
        "hint": "1-200"
      }
    }
  },
  "state": {
    "type": "object",
    "description": "状态参数（情绪 / 作息）",
    "hint": "作息表是「时段 → 状态词」的纯函数，不落盘",
    "items": {
      "rhythm": {
        "type": "string",
        "default": "06:00|刚醒\n09:00|精神不错\n13:00|有点犯困\n18:00|晚饭后放松\n23:00|该睡了",
        "description": "作息表（工作日）",
        "hint": "每行「HH:MM|状态词」；到点的最近一段生效，凌晨归入最后一段；留空＝不出作息行"
      },
      "rhythm_weekend": {
        "type": "string",
        "default": "",
        "description": "作息表（周末）",
        "hint": "周六周日生效；留空＝与工作日同一张"
      },
      "late_night": {
        "type": "string",
        "default": "23:30-06:30",
        "description": "深夜时段",
        "hint": "HH:MM-HH:MM，可跨午夜；留空＝永不深夜"
      }
    }
  },
  "proactive": {
    "type": "object",
    "description": "主动消息参数（频率与冷却）",
    "hint": "巡检制：每 N 分钟问一圈，一轮最多放行一条",
    "items": {
      "patrol_minutes": {
        "type": "int",
        "default": 15,
        "description": "巡检间隔（分钟）",
        "hint": "1-59"
      },
      "daily_limit_private": {
        "type": "int",
        "default": 2,
        "description": "私聊每日上限",
        "hint": "1-10"
      },
      "daily_limit_group": {
        "type": "int",
        "default": 1,
        "description": "群聊每日上限",
        "hint": "0-10；0 ＝ 群里绝不主动"
      },
      "min_interval_minutes": {
        "type": "int",
        "default": 120,
        "description": "同会话最小间隔（分钟）",
        "hint": "0-1440"
      },
      "signal_cooldown_days": {
        "type": "int",
        "default": 3,
        "description": "暗号独立冷却（天）",
        "hint": "1-30"
      },
      "pending_window_hours": {
        "type": "int",
        "default": 6,
        "description": "待回窗口（小时）",
        "hint": "1-48；这段时间里只说她刚找过你"
      },
      "quiet_days": {
        "type": "int",
        "default": 3,
        "description": "久未联系阈值（天）",
        "hint": "1-30"
      },
      "signal_enabled": {
        "type": "bool",
        "default": true,
        "description": "心情暗号",
        "hint": "开=她撑不住时会给你发一个暗号字符（穿透免打扰与配额）；关=完全不发这条信号。其余设置（暗号字符 / 冷却天数）在关着时无意义"
      },
      "signal_char": {
        "type": "string",
        "default": "。",
        "description": "暗号字符",
        "hint": "1~4 个字符；整条消息只有它，不带解释。别用聊天里常见的字符"
      }
    }
  },
  "greeting": {
    "type": "object",
    "description": "早晚安（问候识别与记录）",
    "hint": "他整条消息说早安/晚安时记下来；连续天数与睡眠时长她会自己提到，怎么回应归她",
    "items": {
      "duplicate_minutes": {
        "type": "int",
        "default": 30,
        "description": "重复冷却（分钟）",
        "hint": "0-1440；这段时间里再说的同款问候不重复记录"
      },
      "morning_patterns": {
        "type": "list",
        "default": [
          "早[呀吖啊哈安]?[~～。．.！!？?]*",
          "早上好[呀吖啊哈~～。．.！!？?]*",
          "起床[啦了咯~～。．.！!]*",
          "醒[了啦][~～。．.！!]*",
          "gm"
        ],
        "description": "早安识别词",
        "hint": "每条一个正则，整条消息完全匹配才算；坏条目忽略，全空回落默认"
      },
      "night_patterns": {
        "type": "list",
        "default": [
          "晚安[呀吖啊哈安]?[~～。．.！!？?]*",
          "安安[~～。．.！!]*",
          "睡[了啦][~～。．.！!]*",
          "睡觉[了啦][~～。．.！!]*",
          "去睡[了啦]?[~～。．.！!]*",
          "gn"
        ],
        "description": "晚安识别词",
        "hint": "同上；凌晨 0-4 点的晚安统计上归前一天"
      }
    }
  },
  "pet_bridge": {
    "type": "object",
    "description": "桌宠状态同步",
    "hint": "只同步当前活动、下一项和情绪。默认关闭；设备凭据在设置页的桌宠设备卡签发，不使用管理面板密码。",
    "items": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "开启设备状态服务"
      },
      "host": {
        "type": "string",
        "default": "127.0.0.1",
        "description": "监听 IP",
        "hint": "127.0.0.1 仅本机；跨设备请明确填写手机局域网 IP 或 0.0.0.0，不会自动开放防火墙。"
      },
      "port": {
        "type": "int",
        "default": 6196,
        "description": "状态服务端口",
        "hint": "1024-65535，须与现有服务端口不同。"
      },
      "agent_id": {
        "type": "string",
        "default": "yaya",
        "description": "角色 ID",
        "hint": "配对后桌宠必须匹配这个角色 ID；更改后原设备失效。"
      }
    }
  },
  "life": {
    "type": "object",
    "description": "今天的生活",
    "hint": "为角色安排公开日常，按插件时区每天规划一次；独立于主动消息，不会因此发出 QQ 消息",
    "items": {
      "enabled": {
        "type": "bool",
        "default": true,
        "description": "自动安排一天",
        "hint": "关掉后停止生成和推进，保存的安排保留"
      },
      "provider_id": {
        "type": "string",
        "default": "",
        "description": "规划使用的文本模型",
        "hint": "填写宿主已有的提供商 ID；留空使用当前默认文本模型，不填 API 密钥"
      },
      "character": {
        "type": "string",
        "default": "",
        "multiline": true,
        "description": "她的生活偏好",
        "hint": "可填写公开人设、兴趣和日常目标（最多 1200 字）。留空参考宿主默认人设。内容会交给所选模型，不填写私密聊天"
      },
      "timeout_seconds": {
        "type": "int",
        "default": 30,
        "description": "规划超时（秒）",
        "hint": "5-120；失败保留已有安排或沿用静态作息"
      },
      "retry_minutes": {
        "type": "int",
        "default": 30,
        "description": "失败后重试间隔（分钟）",
        "hint": "5-240；防止模型暂时不可用时连续请求"
      },
      "max_attempts": {
        "type": "int",
        "default": 3,
        "description": "每天最多尝试次数",
        "hint": "1-5；包括失败和手动重试，成功后不会自动重复规划"
      }
    }
  },
  "imagery": {
    "type": "object",
    "description": "状态生图",
    "hint": "按需把「她现在在做什么、在哪、心情怎样」画成一张图：只给面板按钮用，不自动发消息。默认关闭；启用后由配好的提供方计费，请留意每日上限",
    "items": {
      "enabled": {
        "type": "bool",
        "default": false,
        "description": "启用状态生图",
        "hint": "默认关。开启后面板「生图」页出现按钮；关闭时不发任何请求"
      },
      "provider": {
        "type": "string",
        "default": "a1111",
        "description": "提供方",
        "hint": "a1111=本机 Stable Diffusion WebUI API；openai=OpenAI 兼容 Images 接口（云端，按张计费）"
      },
      "base_url": {
        "type": "string",
        "default": "",
        "description": "服务地址",
        "hint": "a1111 例：http://127.0.0.1:7860；openai 例：https://api.openai.com/v1。只支持 http/https"
      },
      "model": {
        "type": "string",
        "default": "",
        "description": "模型名",
        "hint": "openai 必填（如 gpt-image-1 / dall-e-3）；a1111 留空＝用服务当前加载的模型"
      },
      "api_key_env": {
        "type": "string",
        "default": "",
        "description": "密钥环境变量名",
        "hint": "只填「变量名」（如 OPENAI_API_KEY），密钥本体配在宿主环境里；不写名字则不带认证头"
      },
      "size": {
        "type": "string",
        "default": "512x512",
        "description": "尺寸",
        "hint": "「宽x高」。a1111 拆成宽高（64~2048）；openai 按服务端枚举传（如 1024x1024），非法值由服务端报错"
      },
      "steps": {
        "type": "int",
        "default": 20,
        "description": "步数（仅 a1111）",
        "hint": "1-50；openai 没有这个参数，不会假装生效"
      },
      "seed": {
        "type": "int",
        "default": -1,
        "description": "随机种子（仅 a1111）",
        "hint": "-1=每次随机；固定值 + 相同提示词会得到相近图。openai 不支持，不会假装生效"
      },
      "denoising": {
        "type": "int",
        "default": 60,
        "description": "重绘幅度%（仅 a1111 图生图）",
        "hint": "10-90；越低越像参考立绘，越高越自由。只在带参考图时生效"
      },
      "use_reference": {
        "type": "bool",
        "default": true,
        "description": "带当前立绘做参考（仅 a1111）",
        "hint": "a1111 走图生图，人物一致性较强；openai 不支持参考图，一致性只能靠文字锚定（较弱）"
      },
      "timeout_seconds": {
        "type": "int",
        "default": 90,
        "description": "超时（秒）",
        "hint": "5-300；超时已计费不返还（云端按请求计费）"
      },
      "daily_limit": {
        "type": "int",
        "default": 3,
        "description": "每日上限（次）",
        "hint": "1-50；按「请求已发出」记账，失败与超时不返还"
      },
      "character_hint": {
        "type": "string",
        "default": "",
        "multiline": true,
        "description": "人物形象锚定",
        "hint": "外貌、发型、服装等稳定特征（最多 300 字），会进图像提示词。别写私密内容"
      },
      "style_hint": {
        "type": "string",
        "default": "",
        "multiline": true,
        "description": "画风锚定",
        "hint": "画风、质感、构图倾向（最多 200 字），会进图像提示词"
      }
    }
  },
  "voice": {
    "type": "object",
    "description": "语音（主动消息开口说 + 听懂他的语音）",
    "hint": "主动消息过宿主 TTS 变成语音（需要宿主配好 TTS 提供商）；收到语音优先用宿主的转写结果。合成失败自动保持文字，能力以面板「语音能力」为准",
    "items": {
      "mode": {
        "type": "string",
        "default": "off",
        "description": "语音模式",
        "hint": "off=不发语音（默认）；voice=只发语音；dual=语音在前文字在后。非法值回落 off"
      },
      "probability": {
        "type": "int",
        "default": 100,
        "description": "开口概率（%）",
        "hint": "0-100；情绪不好（valence<0）时会自动上浮一些"
      },
      "listen_fallback": {
        "type": "bool",
        "default": true,
        "description": "语音识别兜底",
        "hint": "宿主转写未开启时，收到语音用宿主的识别提供商兜底转一次（同一段不重复转）。宿主已开转写时本项不参与"
      },
      "max_segments": {
        "type": "int",
        "default": 3,
        "description": "单轮语音分段上限",
        "hint": "1-8 段；超出的文本段保持文字，不合成"
      },
      "tts_timeout_seconds": {
        "type": "int",
        "default": 20,
        "description": "单段合成超时（秒）",
        "hint": "3-120；超时该段保持文字，不卡住整条消息"
      },
      "tts_total_seconds": {
        "type": "int",
        "default": 60,
        "description": "整轮合成总预算（秒）",
        "hint": "10-600；预算用完剩余段全部保持文字"
      },
      "audio_retention_hours": {
        "type": "int",
        "default": 6,
        "description": "音频保留时长（小时）",
        "hint": "1-336；合成的音频到期由巡检清理（10 分钟内的绝不删，防止发送前丢失）"
      }
    }
  },
  "social": {
    "type": "object",
    "description": "群社交（登记与短聊）",
    "hint": "只对主人登记且启用的群生效；新登记的群默认不开主动发言",
    "items": {
      "topic_enabled": {
        "type": "bool",
        "default": true,
        "description": "记录群话题",
        "hint": "只对已登记且启用的群记录近期话题（有界），作为接话与注入素材"
      },
      "topic_max_items": {
        "type": "int",
        "default": 12,
        "description": "每群话题条数上限",
        "hint": "1-50；超过挤掉最旧的，不会无限攒群史"
      },
      "topic_max_chars": {
        "type": "int",
        "default": 120,
        "description": "单条话题截断（字）",
        "hint": "20-400；超长群消息只留摘要"
      },
      "topic_ttl_hours": {
        "type": "int",
        "default": 24,
        "description": "话题保鲜期（小时）",
        "hint": "1-168；过期的话题不再进候选与注入"
      },
      "max_rounds": {
        "type": "int",
        "default": 3,
        "description": "bot 短聊轮数上限",
        "hint": "1-10；1 轮 = bot 一条叫她的消息 + 她的一次回话，到上限自己停下"
      },
      "session_window_minutes": {
        "type": "int",
        "default": 10,
        "description": "短聊会话窗口（分钟）",
        "hint": "1-120；bot 超过这么久没有下文，会话自动结束"
      },
      "session_cooldown_minutes": {
        "type": "int",
        "default": 30,
        "description": "短聊冷却（分钟）",
        "hint": "0-1440；会话结束后同一个群多久内不开新短聊"
      },
      "self_names": {
        "type": "string",
        "default": "",
        "description": "她在群里的称呼",
        "hint": "顿号/逗号分隔，如「小澄、澄澄」；空＝不与登记 bot 短聊"
      },
      "max_groups": {
        "type": "int",
        "default": 20,
        "description": "登记群上限",
        "hint": "1-100"
      },
      "seen_max": {
        "type": "int",
        "default": 30,
        "description": "待登记保留条数",
        "hint": "0-100；只对启用范围内看到的群记「最近看到」，超限挤掉最旧的"
      }
    }
  },
  "outbound": {
    "type": "object",
    "description": "出站文本清洗",
    "hint": "发消息前把表情包标记从正文里剥掉",
    "items": {
      "strip_meme_marks": {
        "type": "bool",
        "default": true,
        "description": "剥掉表情包标记",
        "hint": "只处理纯文本组件；关掉则原样发送"
      },
      "marker_pattern": {
        "type": "string",
        "default": "&&[^&\\s]{1,24}&&",
        "description": "标记正则",
        "hint": "Python re 语法；默认只剥 &&名字&&。非法或能匹配空串的正则回落默认"
      }
    }
  },
  "love_peers": {
    "type": "list",
    "default": [],
    "description": "最亲密名单",
    "hint": "填用户 id。名单内的人私聊里的日记进「恋爱日记」那本"
  },
  "name_preference": {
    "type": "dict",
    "default": {},
    "description": "称呼偏好",
    "hint": "{\"用户id\": \"称呼\"}；只改日记标注的写法"
  },
  "bot_isolation": {
    "type": "object",
    "description": "多 Bot 隔离",
    "hint": "开启后日记按真实平台实例 ID 分目录；legacy_platform_id 显式绑定回原数据根（留空＝谁都读不到旧数据）",
    "items": {
      "enable": {
        "type": "bool",
        "default": false,
        "description": "开启多 Bot 隔离"
      },
      "legacy_platform_id": {
        "type": "string",
        "default": "",
        "description": "绑定到原数据根的平台实例 ID",
        "hint": "填真实平台实例 ID（不是适配器类型名）；留空＝不绑定，旧数据谁都读不到"
      }
    }
  },
  "per_instance": {
    "type": "dict",
    "default": {},
    "description": "按实例覆盖",
    "hint": "{\"平台实例ID\": {\"timezone\": \"Asia/Shanghai\"}}；只允许覆盖业务字段，不允许覆盖数据目录等宿主字段"
  }
}
