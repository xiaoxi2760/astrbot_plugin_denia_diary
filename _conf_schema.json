{
  "enabled": {
    "type": "bool",
    "default": true,
    "description": "总开关",
    "hint": "关闭后日记、小本本、状态、主动消息全部停用（数据保留）"
  },
  "timezone": {
    "type": "string",
    "default": "Asia/Shanghai",
    "description": "时区",
    "hint": "IANA 时区名。云主机在 UTC 时必须显式设置，否则日期与提醒时段会错位"
  },
  "data_dir": {
    "type": "string",
    "default": "",
    "description": "数据目录",
    "hint": "留空＝用 AstrBot 的插件数据目录"
  },
  "panel": {
    "type": "object",
    "description": "面板外观",
    "hint": "只改观察面板怎么显示",
    "items": {
      "brand": {
        "type": "string",
        "default": "情绪日记",
        "description": "面板标题",
        "hint": "左上角大字；留空＝不显示"
      },
      "brand_sub": {
        "type": "string",
        "default": "观察面板",
        "description": "面板副标题",
        "hint": "标题下的小字；留空＝不显示"
      }
    }
  },
  "subsystems": {
    "type": "object",
    "description": "子系统开关",
    "hint": "调试期可以只关一块",
    "items": {
      "diary": {
        "type": "bool",
        "default": true,
        "description": "日记",
        "hint": "她能写日记、翻日记"
      },
      "notebook": {
        "type": "bool",
        "default": true,
        "description": "小本本",
        "hint": "记约定与事实"
      },
      "state": {
        "type": "bool",
        "default": true,
        "description": "状态",
        "hint": "情绪 / 作息 / 熟悉度"
      },
      "proactive": {
        "type": "bool",
        "default": true,
        "description": "主动消息",
        "hint": "她主动找你"
      }
    }
  },
  "scope": {
    "type": "object",
    "description": "启用范围",
    "hint": "她在哪里工作：记录 / 注入 / 写工具与主动对象都跟着这一档走",
    "items": {
      "mode": {
        "type": "string",
        "default": "private",
        "description": "档位",
        "hint": "owner=只主人私聊；private=任何私聊（默认）；all=私聊+群聊。非法值回落 private"
      }
    }
  },
  "diary": {
    "type": "object",
    "description": "日记参数",
    "items": {
      "edit_within_days": {
        "type": "int",
        "default": 7,
        "description": "可改天数",
        "hint": "1-60；更早的是历史，只读"
      },
      "max_chars": {
        "type": "int",
        "default": 1200,
        "description": "单条上限（字）",
        "hint": "200-20000"
      },
      "nudge_after_hour": {
        "type": "int",
        "default": 22,
        "description": "深夜催促时刻",
        "hint": "0-23；到这个点还没写就换一句更重的提醒"
      },
      "soft_nudge_after_hour": {
        "type": "int",
        "default": 19,
        "description": "傍晚提醒时刻",
        "hint": "0-23；到点后只轻轻提一句"
      },
      "event_hint_cooldown_min": {
        "type": "int",
        "default": 30,
        "description": "事件提醒冷却（分钟）",
        "hint": "5-1440"
      },
      "fallback_hint_cooldown_min": {
        "type": "int",
        "default": 90,
        "description": "弱提醒冷却（分钟）",
        "hint": "15-1440"
      },
      "exchange_window_min": {
        "type": "int",
        "default": 30,
        "description": "“刚聊过”时间窗（分钟）",
        "hint": "5-1440；判断刚才有没有来回对话"
      }
    }
  },
  "notebook": {
    "type": "object",
    "description": "小本本参数",
    "hint": "每人每类的条目上限；满了不报错，提示先删几条",
    "items": {
      "promise_limit": {
        "type": "int",
        "default": 20,
        "description": "约定上限（每人）",
        "hint": "1-200；按未完成计，完成即腾坑"
      },
      "fact_limit": {
        "type": "int",
        "default": 15,
        "description": "事实上限（每人）",
        "hint": "1-200"
      }
    }
  },
  "state": {
    "type": "object",
    "description": "状态参数（情绪 / 作息）",
    "hint": "作息表是「时段 → 状态词」的纯函数，不落盘",
    "items": {
      "rhythm": {
        "type": "string",
        "default": "06:00|刚醒\n09:00|精神不错\n13:00|有点犯困\n18:00|晚饭后放松\n23:00|该睡了",
        "description": "作息表（工作日）",
        "hint": "每行「HH:MM|状态词」；到点的最近一段生效，凌晨归入最后一段；留空＝不出作息行"
      },
      "rhythm_weekend": {
        "type": "string",
        "default": "",
        "description": "作息表（周末）",
        "hint": "周六周日生效；留空＝与工作日同一张"
      },
      "late_night": {
        "type": "string",
        "default": "23:30-06:30",
        "description": "深夜时段",
        "hint": "HH:MM-HH:MM，可跨午夜；留空＝永不深夜"
      }
    }
  },
  "proactive": {
    "type": "object",
    "description": "主动消息参数（频率与冷却）",
    "hint": "巡检制：每 N 分钟问一圈，一轮最多放行一条",
    "items": {
      "patrol_minutes": {
        "type": "int",
        "default": 15,
        "description": "巡检间隔（分钟）",
        "hint": "1-59"
      },
      "daily_limit_private": {
        "type": "int",
        "default": 2,
        "description": "私聊每日上限",
        "hint": "1-10"
      },
      "daily_limit_group": {
        "type": "int",
        "default": 1,
        "description": "群聊每日上限",
        "hint": "0-10；0 ＝ 群里绝不主动"
      },
      "min_interval_minutes": {
        "type": "int",
        "default": 120,
        "description": "同会话最小间隔（分钟）",
        "hint": "0-1440"
      },
      "signal_cooldown_days": {
        "type": "int",
        "default": 3,
        "description": "暗号独立冷却（天）",
        "hint": "1-30"
      },
      "pending_window_hours": {
        "type": "int",
        "default": 6,
        "description": "待回窗口（小时）",
        "hint": "1-48；这段时间里只说她刚找过你"
      },
      "quiet_days": {
        "type": "int",
        "default": 3,
        "description": "久未联系阈值（天）",
        "hint": "1-30"
      },
      "signal_char": {
        "type": "string",
        "default": "。",
        "description": "心情暗号字符",
        "hint": "1~4 个字符；整条消息只有它，不带解释。别用聊天里常见的字符"
      }
    }
  },
  "outbound": {
    "type": "object",
    "description": "出站文本清洗",
    "hint": "发消息前把表情包标记从正文里剥掉",
    "items": {
      "strip_meme_marks": {
        "type": "bool",
        "default": true,
        "description": "剥掉表情包标记",
        "hint": "只处理纯文本组件；关掉则原样发送"
      },
      "marker_pattern": {
        "type": "string",
        "default": "&&[^&\\s]{1,24}&&",
        "description": "标记正则",
        "hint": "Python re 语法；默认只剥 &&名字&&。非法或能匹配空串的正则回落默认"
      }
    }
  },
  "love_peers": {
    "type": "list",
    "default": [],
    "description": "最亲密名单",
    "hint": "填用户 id。名单内的人私聊里的日记进「恋爱日记」那本"
  },
  "name_preference": {
    "type": "dict",
    "default": {},
    "description": "称呼偏好",
    "hint": "{\"用户id\": \"称呼\"}；只改日记标注的写法"
  }
}
