{
  "enabled": {
    "type": "bool",
    "default": true,
    "description": "总开关",
    "hint": "关闭后日记、小本本、状态、主动消息、早晚安全部停用（数据保留）"
  },
  "timezone": {
    "type": "string",
    "default": "Asia/Shanghai",
    "description": "时区",
    "hint": "IANA 时区名。云主机在 UTC 时必须显式设置，否则日期与提醒时段会错位"
  },
  "data_dir": {
    "type": "string",
    "default": "",
    "description": "数据目录",
    "hint": "留空＝用 AstrBot 的插件数据目录"
  },
  "panel": {
    "type": "object",
    "description": "面板外观",
    "hint": "只改观察面板怎么显示",
    "items": {
      "brand": {
        "type": "string",
        "default": "情绪日记",
        "description": "面板标题",
        "hint": "左上角大字；留空＝不显示"
      },
      "brand_sub": {
        "type": "string",
        "default": "观察面板",
        "description": "面板副标题",
        "hint": "标题下的小字；留空＝不显示"
      }
    }
  },
  "subsystems": {
    "type": "object",
    "description": "子系统开关",
    "hint": "调试期可以只关一块",
    "items": {
      "diary": {
        "type": "bool",
        "default": true,
        "description": "日记",
        "hint": "她能写日记、翻日记"
      },
      "notebook": {
        "type": "bool",
        "default": true,
        "description": "小本本",
        "hint": "记约定与事实"
      },
      "state": {
        "type": "bool",
        "default": true,
        "description": "状态",
        "hint": "情绪 / 作息 / 熟悉度"
      },
      "proactive": {
        "type": "bool",
        "default": true,
        "description": "主动消息",
        "hint": "她主动找你"
      },
      "greeting": {
        "type": "bool",
        "default": true,
        "description": "早晚安",
        "hint": "他说早安/晚安时记下来，她自然接话；关了就当普通聊天"
      }
    }
  },
  "scope": {
    "type": "object",
    "description": "启用范围",
    "hint": "她在哪里工作：记录 / 注入 / 写工具与主动对象都跟着这一档走",
    "items": {
      "mode": {
        "type": "string",
        "default": "private",
        "description": "档位",
        "hint": "owner=只主人私聊；private=任何私聊（默认）；all=私聊+群聊。非法值回落 private"
      }
    }
  },
  "diary": {
    "type": "object",
    "description": "日记参数",
    "items": {
      "edit_within_days": {
        "type": "int",
        "default": 7,
        "description": "可改天数",
        "hint": "1-60；更早的是历史，只读"
      },
      "panel_edit_unlimited": {
        "type": "bool",
        "default": false,
        "description": "面板不受可改天数限制",
        "hint": "关（默认）＝面板与聊天同一口径，只能改最近这些天；开＝只有 WebUI 面板能改任何一段，聊天侧仍然守 7 天"
      },
      "max_chars": {
        "type": "int",
        "default": 1200,
        "description": "单条上限（字）",
        "hint": "200-20000"
      },
      "nudge_after_hour": {
        "type": "int",
        "default": 22,
        "description": "深夜催促时刻",
        "hint": "0-23；到这个点还没写就换一句更重的提醒"
      },
      "soft_nudge_after_hour": {
        "type": "int",
        "default": 19,
        "description": "傍晚提醒时刻",
        "hint": "0-23；到点后只轻轻提一句"
      },
      "event_hint_cooldown_min": {
        "type": "int",
        "default": 30,
        "description": "事件提醒冷却（分钟）",
        "hint": "5-1440"
      },
      "fallback_hint_cooldown_min": {
        "type": "int",
        "default": 90,
        "description": "弱提醒冷却（分钟）",
        "hint": "15-1440"
      },
      "exchange_window_min": {
        "type": "int",
        "default": 30,
        "description": "“刚聊过”时间窗（分钟）",
        "hint": "5-1440；判断刚才有没有来回对话"
      },
      "card_render": {
        "type": "string",
        "default": "pretty",
        "description": "日记卡渲染方式（/看日记）",
        "hint": "pretty=精美卡片；plain=本地朴素图；off=只发文本。默认禁止上传日记，允许远端出图需另开开关"
      },
      "card_style": {
        "type": "string",
        "default": "paper",
        "description": "日记卡款式",
        "hint": "paper=纸感（默认）；ink=墨信；postcard=明信片；tape=手帐；dots=点阵本；seal=火漆信笺。非法值回落 paper"
      },
      "card_font": {
        "type": "string",
        "default": "",
        "description": "日记卡字体（自定义）",
        "hint": "留空＝用款式自带的字体。填字体名（如 Noto Serif SC）或字体文件直链（http…woff2 / ttf / otf）都行"
      },
      "card_engine": {
        "type": "string",
        "default": "auto",
        "description": "日记卡出图引擎（pretty 档）",
        "hint": "playwright=本机 Chrome/Edge 截图（约1秒，排版最贴模板）；remote=AstrBot 官方转图服务（约4-6秒，六款样式都能选）；pil=Pillow 直接画（完全离线，但只画纸感那一款）；auto=按前三者顺序挑第一个可用的（默认）。选中的引擎失败会自动往下退并记日志。非法值回落 auto"
      },
      "card_allow_remote": {
        "type": "bool",
        "default": false,
        "description": "允许把日记发到远端转图服务",
        "hint": "关（默认）＝日记只在本机出图（playwright → pil），任何引擎失败都不会上传到远端；开＝允许 remote 引擎上传整张日记卡到 AstrBot 官方转图服务。这一项优先于上面的引擎选择：选了 remote/auto 但这里是关的，就当 remote 不存在，改走本机引擎并在日志里说明"
      }
    }
  },
  "notebook": {
    "type": "object",
    "description": "小本本参数",
    "hint": "每人每类的条目上限；满了不报错，提示先删几条",
    "items": {
      "promise_limit": {
        "type": "int",
        "default": 20,
        "description": "约定上限（每人）",
        "hint": "1-200；按未完成计，完成即腾坑"
      },
      "fact_limit": {
        "type": "int",
        "default": 15,
        "description": "事实上限（每人）",
        "hint": "1-200"
      }
    }
  },
  "state": {
    "type": "object",
    "description": "状态参数（情绪 / 作息）",
    "hint": "作息表是「时段 → 状态词」的纯函数，不落盘",
    "items": {
      "rhythm": {
        "type": "string",
        "default": "06:00|刚醒\n09:00|精神不错\n13:00|有点犯困\n18:00|晚饭后放松\n23:00|该睡了",
        "description": "作息表（工作日）",
        "hint": "每行「HH:MM|状态词」；到点的最近一段生效，凌晨归入最后一段；留空＝不出作息行"
      },
      "rhythm_weekend": {
        "type": "string",
        "default": "",
        "description": "作息表（周末）",
        "hint": "周六周日生效；留空＝与工作日同一张"
      },
      "late_night": {
        "type": "string",
        "default": "23:30-06:30",
        "description": "深夜时段",
        "hint": "HH:MM-HH:MM，可跨午夜；留空＝永不深夜"
      }
    }
  },
  "proactive": {
    "type": "object",
    "description": "主动消息参数（频率与冷却）",
    "hint": "巡检制：每 N 分钟问一圈，一轮最多放行一条",
    "items": {
      "patrol_minutes": {
        "type": "int",
        "default": 15,
        "description": "巡检间隔（分钟）",
        "hint": "1-59"
      },
      "daily_limit_private": {
        "type": "int",
        "default": 2,
        "description": "私聊每日上限",
        "hint": "1-10"
      },
      "daily_limit_group": {
        "type": "int",
        "default": 1,
        "description": "群聊每日上限",
        "hint": "0-10；0 ＝ 群里绝不主动"
      },
      "min_interval_minutes": {
        "type": "int",
        "default": 120,
        "description": "同会话最小间隔（分钟）",
        "hint": "0-1440"
      },
      "signal_cooldown_days": {
        "type": "int",
        "default": 3,
        "description": "暗号独立冷却（天）",
        "hint": "1-30"
      },
      "pending_window_hours": {
        "type": "int",
        "default": 6,
        "description": "待回窗口（小时）",
        "hint": "1-48；这段时间里只说她刚找过你"
      },
      "quiet_days": {
        "type": "int",
        "default": 3,
        "description": "久未联系阈值（天）",
        "hint": "1-30"
      },
      "signal_enabled": {
        "type": "bool",
        "default": true,
        "description": "心情暗号",
        "hint": "开=她撑不住时会给你发一个暗号字符（穿透免打扰与配额）；关=完全不发这条信号。其余设置（暗号字符 / 冷却天数）在关着时无意义"
      },
      "signal_char": {
        "type": "string",
        "default": "。",
        "description": "暗号字符",
        "hint": "1~4 个字符；整条消息只有它，不带解释。别用聊天里常见的字符"
      }
    }
  },
  "greeting": {
    "type": "object",
    "description": "早晚安（问候识别与记录）",
    "hint": "他整条消息说早安/晚安时记下来；连续天数与睡眠时长她会自己提到，怎么回应归她",
    "items": {
      "duplicate_minutes": {
        "type": "int",
        "default": 30,
        "description": "重复冷却（分钟）",
        "hint": "0-1440；这段时间里再说的同款问候不重复记录"
      },
      "morning_patterns": {
        "type": "list",
        "default": [
          "早[呀吖啊哈安]?[~～。．.！!？?]*",
          "早上好[呀吖啊哈~～。．.！!？?]*",
          "起床[啦了咯~～。．.！!]*",
          "醒[了啦][~～。．.！!]*",
          "gm"
        ],
        "description": "早安识别词",
        "hint": "每条一个正则，整条消息完全匹配才算；坏条目忽略，全空回落默认"
      },
      "night_patterns": {
        "type": "list",
        "default": [
          "晚安[呀吖啊哈安]?[~～。．.！!？?]*",
          "安安[~～。．.！!]*",
          "睡[了啦][~～。．.！!]*",
          "睡觉[了啦][~～。．.！!]*",
          "去睡[了啦]?[~～。．.！!]*",
          "gn"
        ],
        "description": "晚安识别词",
        "hint": "同上；凌晨 0-4 点的晚安统计上归前一天"
      }
    }
  },
  "voice": {
    "type": "object",
    "description": "语音（主动消息开口说）",
    "hint": "她的主动消息过宿主 TTS 变成语音发出；需要先在宿主配好一个 TTS 提供商。合成失败自动保持文字",
    "items": {
      "mode": {
        "type": "string",
        "default": "off",
        "description": "语音模式",
        "hint": "off=不发语音（默认）；voice=只发语音；dual=语音在前文字在后。非法值回落 off"
      },
      "probability": {
        "type": "int",
        "default": 100,
        "description": "开口概率（%）",
        "hint": "0-100；情绪不好（valence<0）时会自动上浮一些"
      }
    }
  },
  "outbound": {
    "type": "object",
    "description": "出站文本清洗",
    "hint": "发消息前把表情包标记从正文里剥掉",
    "items": {
      "strip_meme_marks": {
        "type": "bool",
        "default": true,
        "description": "剥掉表情包标记",
        "hint": "只处理纯文本组件；关掉则原样发送"
      },
      "marker_pattern": {
        "type": "string",
        "default": "&&[^&\\s]{1,24}&&",
        "description": "标记正则",
        "hint": "Python re 语法；默认只剥 &&名字&&。非法或能匹配空串的正则回落默认"
      }
    }
  },
  "love_peers": {
    "type": "list",
    "default": [],
    "description": "最亲密名单",
    "hint": "填用户 id。名单内的人私聊里的日记进「恋爱日记」那本"
  },
  "name_preference": {
    "type": "dict",
    "default": {},
    "description": "称呼偏好",
    "hint": "{\"用户id\": \"称呼\"}；只改日记标注的写法"
  }
}
